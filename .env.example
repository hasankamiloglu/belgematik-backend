# .env.example -> .env dosyasının ÖRNEĞİ. Bu dosya GitHub'a gider, içinde gerçek şifre YOKTUR.
# Kullanım: bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.

FLASK_ENV=development
# SECRET_KEY: Giriş token'ları (JWT) bu anahtarla imzalanır. En az 32 karakter, rastgele olmalı.
# Üretmek için terminalde:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-uzun-rastgele-bir-metin-yazin

# Oturum (token) süresi, dakika
TOKEN_SURESI_DAKIKA=60

# Backend'e istek atabilecek frontend adresleri (virgülle ayrılır)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL bağlantısı (Hafta 4)
# Biçim: postgresql://KULLANICI:SIFRE@SUNUCU:PORT/VERITABANI
# "sifreniz" yerine PostgreSQL kurulumunda belirlediğiniz şifreyi yazın.
DATABASE_URL=postgresql://postgres:sifreniz@localhost:5432/belgematik

# ---- Harici OCR API: OCR.space (Hafta 9) ----
# Hangi OCR motoru kullanılsın?
#   otomatik  -> anahtar varsa önce OCR.space, hata olursa Tesseract (önerilen)
#   api       -> sadece OCR.space (hata olursa kullanıcıya hata döner)
#   tesseract -> sadece bilgisayardaki Tesseract
OCR_MOTORU=otomatik
# Ücretsiz anahtar: https://ocr.space/ocrapi/freekey  (e-postanıza gelir)
# GERÇEK ANAHTARI SADECE .env DOSYASINA YAZIN. Bu dosyaya (.env.example) YAZMAYIN.
OCR_API_ANAHTARI=
# OCR.space dil kodu (tur = Türkçe) ve motoru (1 = Türkçeyi destekleyen motor)
OCR_API_DIL=tur
OCR_API_MOTOR=1
# Kendi hız sınırımız: dakikada en fazla kaç API çağrısı (ücretsiz paket günde 500)
OCR_API_DAKIKA_SINIRI=10

# Tesseract OCR programının yeri (Hafta 7). Varsayılan Windows klasörüne kurulduysa
# BOŞ bırakın; program kendisi bulur. Başka yere kurduysanız tam yolu yazın:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

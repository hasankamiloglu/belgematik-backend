# .env.example -> .env dosyasının ÖRNEĞİ. Bu dosya GitHub'a gider, içinde gerçek şifre YOKTUR.
# Kullanım: bu dosyayı kopyalayıp adını ".env" yapın ve değerleri doldurun.

FLASK_ENV=development
# SECRET_KEY: Giriş token'ları (JWT) bu anahtarla imzalanır. En az 32 karakter, rastgele olmalı.
# Üretmek için terminalde:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-uzun-rastgele-bir-metin-yazin

# Oturum (token) süresi, dakika
TOKEN_SURESI_DAKIKA=60

# Backend'e istek atabilecek frontend adresleri (virgülle ayrılır)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL bağlantısı (Hafta 4)
# Biçim: postgresql://KULLANICI:SIFRE@SUNUCU:PORT/VERITABANI
# "sifreniz" yerine PostgreSQL kurulumunda belirlediğiniz şifreyi yazın.
DATABASE_URL=postgresql://postgres:sifreniz@localhost:5432/belgematik

# Hafta 7'de doldurulacak (yapay zekâ API anahtarı)
AI_API_KEY=

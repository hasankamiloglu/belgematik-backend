digraph Mimari {
  rankdir=TB; bgcolor="white"; fontname="Helvetica"; nodesep=0.35; ranksep=0.5; compound=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#8a8f9c", fillcolor="white", margin="0.18,0.08"];
  edge [color="#5d6677", fontname="Helvetica", fontsize=10, arrowsize=0.7];
  label="Belgematik - Mimari Sema (Frontend ve Backend ayri depolar)"; labelloc=t; fontsize=18;

  kullanici [label="Kullanici\n(Tarayici / Telefon)", shape=ellipse, fillcolor="#f1e9f8", color="#5b2a86"];

  subgraph cluster_fe {
    label="DEPO 1: belgematik-frontend  (React + Vite)  -  localhost:5173";
    style="rounded,filled"; fillcolor="#fff6e8"; color="#c27a12"; fontsize=13;
    app_jsx [label="App.jsx\n(ana bilesen)"];
    comps [label="pages/ + components/\nGiris, Kayit, Panel, Belgelerim, Yonetici\nYuklemeAlani, Karsilastirma, KorumaliSayfa"];
    client [label="api/client.js\n(fetch + Authorization: Bearer token)"];
    app_jsx -> comps -> client;
  }

  subgraph cluster_be {
    label="DEPO 2: belgematik-backend  (Python + Flask)  -  127.0.0.1:5000";
    style="rounded,dashed"; color="#5d6677"; fontsize=13;
    subgraph cluster_api {
      label="1) SUNUM katmani - app/api/"; style="rounded,filled"; fillcolor="#f4eefa"; color="#5b2a86";
      routes [label="routes.py\n/api/saglik   /api/moduller"];
      belge_api [label="belgeler.py\n/api/belgeler  (yukle, listele, gorsel, sil)"];
      kimlik_api [label="kimlik.py + yetki.py\n/api/auth/*  /api/yonetici/*\n@giris_gerekli  @yetki_gerekli"];
    }
    subgraph cluster_is {
      label="2) IS katmani - app/services/"; style="rounded,filled"; fillcolor="#eef3fb"; color="#2f5ea8";
      auth [label="auth/\nParola hash, JWT, giris akisi", fillcolor="#fdf3e1"];
      belge_srv [label="belge_servisi.py\nkredi, sahiplik, tekrar kontrolu", fillcolor="#fdf3e1"];
      prep [label="preprocessing/\nkalite olcumu + on isleme (Pillow)", fillcolor="#fdf3e1"];
      ocr [label="ocr/\nMetin okuma"];
      extraction [label="extraction/\nAlan esleme"];
      validation [label="validation/\nDogrulama"];
      export [label="export/\nExcel - CSV - JSON"];
      ocr -> extraction -> validation -> export;
    }
    subgraph cluster_veri {
      label="3) VERI katmani - app/data/"; style="rounded,filled"; fillcolor="#edf7f1"; color="#1f8a5b";
      repos [label="repositories/\n(CRUD - saf SQL)"];
      models [label="db.py + migrate.py\n(baglanti, db/migrations/*.sql)"];
      repos -> models;
    }
  }

  subgraph cluster_dis {
    label="DIS SISTEMLER"; style="rounded,dashed"; color="#8a8f9c";
    pg [label="PostgreSQL", shape=cylinder, fillcolor="#f6f7fb"];
    disk [label="uploads/<kullanici_id>/\n(orijinal, islenmis, kucuk)", shape=folder, fillcolor="#f6f7fb"];
    tess [label="Tesseract OCR\n(ucretsiz mod)", fillcolor="#f6f7fb"];
    llm [label="Yapay Zeka API\n(pro mod)", fillcolor="#f6f7fb"];
  }

  kullanici -> app_jsx [label=" sayfayi acar"];
  client -> routes [label=" HTTP istegi / JSON cevap\n (CORS izinli)", color="#c27a12", fontcolor="#c27a12", penwidth=1.8, dir=both];
  belge_api -> belge_srv;
  belge_srv -> prep;
  prep -> ocr [label=" on_islendi -> OCR (Hafta 7)", style=dashed];
  belge_srv -> repos [label=" belge + kredi"];
  belge_srv -> disk;
  kimlik_api -> auth;
  auth -> repos [label=" kullanici / giris kaydi"];
  validation -> repos [label=" kaydet / oku"];
  models -> pg [label=" SQL"];
  ocr -> tess;
  ocr -> llm;
}
